# gateway/Caddyfile  —  the single front door for the whole stack
{
	admin :2019          # /metrics for Prometheus (LAB 4)
	auto_https off       # plain HTTP on a lab machine
	servers {
		metrics          # opt in to per-server Prometheus metrics
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	# ---- API ----------------------------------------------------------------
	# LAB 4: `dynamic a` re-resolves the `backend` DNS name on a timer, so new
	# replicas from `--scale backend=N` are picked up without restarting Caddy.
	handle_path /api/* {
		reverse_proxy {
			dynamic a {
				name    backend
				port    3001
				refresh 2s
			}
			lb_policy round_robin
			fail_duration 10s
			health_uri /healthz
			health_interval 5s
			health_timeout 2s
			header_up X-Forwarded-Prefix /api
		}
	}

	# ---- Chaos control plane (LAB 3) ---------------------------------------
	handle_path /flaky/* {
		reverse_proxy flaky:3002
	}

	# ---- Static frontend ----------------------------------------------------
	handle {
		reverse_proxy frontend:80
	}
}
