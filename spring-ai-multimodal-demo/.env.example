# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your key:   cp .env.example .env
# spring-dotenv loads these into Spring's Environment automatically at startup.
# ---------------------------------------------------------------------------

# REQUIRED. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Everything below is OPTIONAL (sensible defaults are used) --------------

# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Text -> Image  ("Nano Banana" family). Returns inline PNG.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Audio -> Text  (any multimodal Gemini model can transcribe inline audio)
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Text -> Speech  (returns 16-bit PCM, wrapped to WAV by the app)
# GEMINI_SPEECH_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_SPEECH_VOICE=Kore   # try: Puck, Charon, Fenrir, Aoede, Leda ...

