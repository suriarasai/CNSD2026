###############################################
# TickIt — .gitignore
# Ignores all generated build output, IDE files,
# secrets, and OS cruft. Source, pom.xml, the
# Maven wrapper scripts, and IaC files stay tracked.
###############################################

############### Maven build output ###############
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# The wrapper jar is downloaded on first run; do not commit binaries.
.mvn/wrapper/maven-wrapper.jar

############### Compiled Java ###############
*.class
# Standalone packaged artifacts (the bootable jar lives in target/ anyway)
*.jar
*.war
*.ear
*.nar
# JVM crash logs
hs_err_pid*
replay_pid*

